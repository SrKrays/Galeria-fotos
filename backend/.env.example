# Variables del backend. En tu PC: copiá este archivo como ".env" y cargalas antes de correr
# (ver README.md). En Render: se cargan una por una en Environment. NUNCA subas el .env real al repositorio.

# ── Base de datos ──
# En tu PC:
ConnectionStrings__Galeria=Host=localhost;Port=5432;Database=galeria;Username=postgres;Password=TU_CLAVE_DE_POSTGRES
# En Render alcanza con DATABASE_URL (la "Internal Database URL" de tu base); si existe, tiene prioridad.
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# ── Sesiones del panel ──
# Texto secreto al azar de 32 caracteres o más. Si lo cambiás, todos tienen que volver a ingresar.
Jwt__Clave=CAMBIAR_POR_UN_TEXTO_LARGO_Y_AL_AZAR_DE_MAS_DE_32

# ── Primer administrador ──
# Solo se usa la primera vez, cuando todavía no hay ningún usuario. Clave de 10 caracteres o más.
Admin__Usuario=antonio
Admin__Clave=CAMBIAR_POR_UNA_CLAVE_LARGA

# ── Quién puede llamar a la API desde un navegador (separados por coma, sin barra final) ──
Cors__Origenes=http://localhost:5173

# ── Dónde se guardan las fotos ──
# "local" = carpeta backend/GaleriaCarrizo.Api/almacen (para probar en tu PC)
# "r2"    = Cloudflare R2 (producción)
Almacenamiento__Tipo=local
# Solo para r2:
# Almacenamiento__CuentaId=            (Account ID de Cloudflare)
# Almacenamiento__ClaveAcceso=         (Access Key ID del token de R2)
# Almacenamiento__ClaveSecreta=        (Secret Access Key del token de R2)
# Almacenamiento__BucketPrivado=carrizo-originales      (sin acceso público)
# Almacenamiento__BucketPublico=carrizo-fotos           (con dominio público)
# Almacenamiento__UrlPublica=https://fotos.tudominio.com

# ── Marca de agua (opcional; estos son los valores por defecto) ──
# Imagenes__MarcaDeAgua=© Antonio Carrizo
# Imagenes__OpacidadMarca=0.14
